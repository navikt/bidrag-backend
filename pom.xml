<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>no.nav.bidrag</groupId>
    <artifactId>bidrag-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Bidrag-backend</name>
    <description>Monorepo for team Bidrag sine backend-tjenester</description>

    <modules>
        <module>apps/bidrag-oppgave</module>
        <module>libs/bidrag-oppgave-client</module>
        <module>libs/bidrag-oppgave-dto</module>
        <module>libs/bidrag-felles/bidrag-domene</module>
        <module>libs/bidrag-felles/bidrag-transport</module>
        <module>libs/bidrag-felles/bidrag-commons</module>
        <module>libs/bidrag-felles/bidrag-commons-test</module>
        <module>libs/bidrag-felles/bidrag-generer-testdata</module>
        <module>apps/bidrag-regnskap</module>
        <module>apps/bidrag-aktoerregister</module>
        <module>apps/bidrag-arbeidsflyt</module>
        <module>apps/bidrag-reskontro</module>
        <module>apps/bidrag-elin-stub</module>
        <module>apps/bidrag-admin</module>
        <module>apps/bidrag-dokumenthåndtering</module>
        <module>apps/bidrag-kodeverk</module>
        <module>apps/bidrag-maskinporten-client</module>
        <module>apps/bidrag-automatisk-jobb</module>
        <module>apps/bidrag-behandling</module>
        <module>apps/bidrag-belopshistorikk</module>
        <module>apps/bidrag-bbm</module>
        <module>apps/bidrag-bidragskalkulator</module>
        <module>apps/bidrag-grunnlag</module>
        <module>apps/bidrag-organisasjon</module>
        <module>apps/bidrag-samhandler</module>
        <module>apps/bidrag-sak</module>
        <module>apps/bidrag-sjablon</module>
        <module>apps/bidrag-person-hendelse</module>
        <module>apps/bidrag-person</module>
        <module>apps/bidrag-statistikk</module>
        <module>apps/bidrag-tilgangskontroll</module>
        <module>apps/bidrag-reisekostnad-api</module>
        <module>apps/bidrag-vedtak</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <kotlin.version>2.4.10</kotlin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Nav moduler -->
        <bidrag-beregn-felles.version>2026.08.21.075458</bidrag-beregn-felles.version>
        <nav-token-support.version>6.0.12</nav-token-support.version>
        <aordningen-inntektsinformasjon-v1.version>1.7</aordningen-inntektsinformasjon-v1.version>

        <!-- Andre avhengigheter -->
        <jackson.version>2.21.2</jackson.version>
        <spring-retry.version>2.0.13</spring-retry.version>
        <kotlin-logging-jvm.version>8.0.4</kotlin-logging-jvm.version>
        <slack-api.version>1.49.0</slack-api.version>
        <shedlock.version>7.7.0</shedlock.version>
        <jsch.version>2.28.6</jsch.version>
        <google-cloud-storage.version>2.71.0</google-cloud-storage.version>
        <spring-cloud-contract-wiremock.version>5.0.3</spring-cloud-contract-wiremock.version>
        <springdoc-openapi-ui.version>3.1.0</springdoc-openapi-ui.version>
        <logback-encoder.version>9.0</logback-encoder.version>
        <okhttp.version>5.4.0</okhttp.version>
        <unleash-client-java.version>12.2.2</unleash-client-java.version>
        <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
        <circuitbreaker.version>5.0.2</circuitbreaker.version>
        <google-guava.version>33.0.0-jre</google-guava.version>
        <jakarta.xml.ws-api.version>4.0.1</jakarta.xml.ws-api.version>
        <jaxws.version>4.0.3</jaxws.version>
        <hypersistence-utils-hibernate.version>3.15.2</hypersistence-utils-hibernate.version>

        <!-- db2 -->
        <db2.db2jcc4.version>10.5fp6</db2.db2jcc4.version>
        <db2.db2jcc_license_cu.version>9.7</db2.db2jcc_license_cu.version>
        <db2.jcc.version>12.1.4.0</db2.jcc.version>

        <!-- bidrag-person-hendelse -->
        <ibm-mq-jakarta-client.version>9.4.5.1</ibm-mq-jakarta-client.version>
        <apache-avro.version>1.12.1</apache-avro.version>
        <confluent.version>8.0.0</confluent.version>

        <!-- Test-versjoner -->
        <wiremock-spring-boot.version>4.2.1</wiremock-spring-boot.version>
        <wiremock-standalone.version>3.13.2</wiremock-standalone.version>
        <springmockk.version>5.0.1</springmockk.version>
        <mockk.version>1.14.11</mockk.version>
        <mockito-kotlin.version>6.3.0</mockito-kotlin.version>
        <kotest.version>6.2.3</kotest.version>
        <swagger-annotations.version>2.2.51</swagger-annotations.version>

        <!-- Plugin-versjoner -->
        <ktlint.version>1.8.0</ktlint.version>
        <versions-maven-plugin.version>2.21.0</versions-maven-plugin.version>

        <!-- Test-avhengigheter -->
        <mock-oauth2-server.version>2.1.10</mock-oauth2-server.version>
    </properties>

    <!-- Sikrer at alle mockk-relaterte artefakter alltid samstemmer med
         mockk.version. Uten dette kan f.eks. springmockk trekke inn en eldre
         mockk-dsl-jvm enn den bidrag-commons-test-felles sin Stubs.kt kompileres
         mot, noe som kan gi NoClassDefFoundError for klasser som er lagt til i
         nyere mockk-versjoner (f.eks. AnyTypedMatcher, introdusert i 1.14.9). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.mockk</groupId>
                <artifactId>mockk-jvm</artifactId>
                <version>${mockk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.mockk</groupId>
                <artifactId>mockk-dsl-jvm</artifactId>
                <version>${mockk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.mockk</groupId>
                <artifactId>mockk-agent-jvm</artifactId>
                <version>${mockk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.mockk</groupId>
                <artifactId>mockk-agent-api-jvm</artifactId>
                <version>${mockk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.mockk</groupId>
                <artifactId>mockk-core-jvm</artifactId>
                <version>${mockk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Kotlin-stdlib må være inkludert for maven-plugin -->
    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/navikt/bidrag-felles</url>
        </repository>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

    <profiles>
        <profile>
            <id>it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>default</id>
            <activation>
                <property>
                    <name>profile.default.on</name>
                    <value>true</value>
                </property>
            </activation>
            <repositories>
                <repository>
                    <id>github</id>
                    <url>https://maven.pkg.github.com/navikt/bidrag-felles</url>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <build>
        <finalName>app</finalName>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>

        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <environmentVariables>
                <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
              </environmentVariables>
            </configuration>
          </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                    </args>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                        <plugin>jpa</plugin>
                    </compilerPlugins>
                    <jvmTarget>${java.version}</jvmTarget>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-noarg</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <executions>
                    <execution>
                        <id>ktlint</id>
                        <phase>verify</phase>
                        <configuration>
                            <target name="ktlint">
                                <java taskname="ktlint" dir="${basedir}" fork="true" failonerror="true"
                                      classpathref="maven.plugin.classpath" classname="com.pinterest.ktlint.Main">
                                    <arg value="src/**/*.kt"/>
                                </java>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>ktlint-format</id>
                        <phase>none</phase>
                        <configuration>
                            <target name="ktlint">
                                <java taskname="ktlint" dir="${basedir}" fork="true" failonerror="true"
                                      classpathref="maven.plugin.classpath" classname="com.pinterest.ktlint.Main">
                                    <jvmarg value="--add-opens"/>
                                    <jvmarg value="java.base/java.lang=ALL-UNNAMED"/>
                                    <arg value="-F"/>
                                    <arg value="src/**/*.kt"/>
                                </java>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.pinterest.ktlint</groupId>
                        <artifactId>ktlint-cli</artifactId>
                        <version>${ktlint.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>

