<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>no.nav.bidrag</groupId>
    <artifactId>bidrag-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Bidrag-backend</name>
    <description>Monorepo for team Bidrag sine backend-tjenester</description>

    <modules>
        <module>apps/bidrag-oppgave</module>
        <module>libs/bidrag-oppgave-client</module>
        <module>libs/bidrag-oppgave-dto</module>
        <module>libs/bidrag-felles/bidrag-domene</module>
        <module>libs/bidrag-felles/bidrag-transport</module>
        <module>libs/bidrag-felles/bidrag-commons</module>
        <module>libs/bidrag-felles/bidrag-commons-test</module>
        <module>libs/bidrag-felles/bidrag-generer-testdata</module>
        <module>libs/bidrag-beregn-felles/bidrag-beregn-core</module>
        <module>libs/bidrag-beregn-felles/bidrag-beregn-forskudd</module>
        <module>libs/bidrag-beregn-felles/bidrag-beregn-boforhold</module>
        <module>libs/bidrag-beregn-felles/bidrag-beregn-inntekt</module>
        <module>libs/bidrag-beregn-felles/bidrag-beregn-sivilstand</module>
        <module>libs/bidrag-beregn-felles/bidrag-beregn-særbidrag</module>
        <module>libs/bidrag-beregn-felles/bidrag-beregn-indeksregulering</module>
        <module>libs/bidrag-beregn-felles/bidrag-beregn-vedtak</module>
        <module>libs/bidrag-beregn-felles/bidrag-beregn-barnebidrag</module>
        <module>libs/bidrag-beregn-felles/bidrag-beregn-debug-app</module>
        <module>apps/bidrag-regnskap</module>
        <module>apps/bidrag-aktoerregister</module>
        <module>apps/bidrag-arbeidsflyt</module>
        <module>apps/bidrag-reskontro</module>
        <module>apps/bidrag-elin-stub</module>
        <module>apps/bidrag-admin</module>
        <module>apps/bidrag-dokumenthåndtering</module>
        <module>apps/bidrag-kodeverk</module>
        <module>apps/bidrag-maskinporten-client</module>
        <module>apps/bidrag-automatisk-jobb</module>
        <module>apps/bidrag-behandling</module>
        <module>apps/bidrag-belopshistorikk</module>
        <module>apps/bidrag-bbm</module>
        <module>apps/bidrag-bidragskalkulator</module>
        <module>apps/bidrag-grunnlag</module>
        <module>apps/bidrag-organisasjon</module>
        <module>apps/bidrag-samhandler</module>
        <module>apps/bidrag-sak</module>
        <module>apps/bidrag-sjablon</module>
        <module>apps/bidrag-person-hendelse</module>
        <module>apps/bidrag-person</module>
        <module>apps/bidrag-statistikk</module>
        <module>apps/bidrag-tilgangskontroll</module>
        <module>apps/bidrag-reisekostnad-api</module>
        <module>apps/bidrag-vedtak</module>
    </modules>

    <!-- Versjonsegenskaper her er kun de som root-pom-en selv trenger for sin
         egen build (Kotlin-kompilering, ktlint, versions-maven-plugin) -->
    <properties>
        <java.version>21</java.version>
        <kotlin.version>2.4.10</kotlin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Plugin-versjoner -->
        <ktlint.version>1.8.0</ktlint.version>
        <versions-maven-plugin.version>2.21.0</versions-maven-plugin.version>
    </properties>

    <!-- Kotlin-stdlib må være inkludert for maven-plugin -->
    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/navikt/token-support</url>
        </repository>
    </repositories>

    <profiles>
        <profile>
            <id>it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>default</id>
            <activation>
                <property>
                    <name>profile.default.on</name>
                    <value>true</value>
                </property>
            </activation>
        </profile>
    </profiles>

    <build>
        <finalName>app</finalName>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>

        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <environmentVariables>
                <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
              </environmentVariables>
            </configuration>
          </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                    </args>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                        <plugin>jpa</plugin>
                    </compilerPlugins>
                    <jvmTarget>${java.version}</jvmTarget>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-noarg</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <executions>
                    <execution>
                        <id>ktlint</id>
                        <phase>verify</phase>
                        <configuration>
                            <target name="ktlint">
                                <java taskname="ktlint" dir="${basedir}" fork="true" failonerror="true"
                                      classpathref="maven.plugin.classpath" classname="com.pinterest.ktlint.Main">
                                    <arg value="src/**/*.kt"/>
                                </java>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>ktlint-format</id>
                        <phase>none</phase>
                        <configuration>
                            <target name="ktlint">
                                <java taskname="ktlint" dir="${basedir}" fork="true" failonerror="true"
                                      classpathref="maven.plugin.classpath" classname="com.pinterest.ktlint.Main">
                                    <jvmarg value="--add-opens"/>
                                    <jvmarg value="java.base/java.lang=ALL-UNNAMED"/>
                                    <arg value="-F"/>
                                    <arg value="src/**/*.kt"/>
                                </java>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.pinterest.ktlint</groupId>
                        <artifactId>ktlint-cli</artifactId>
                        <version>${ktlint.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>

