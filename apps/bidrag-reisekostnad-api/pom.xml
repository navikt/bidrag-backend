    <!-- Test -->
    <!-- Nav sine testverktøy og hjelpefunksjoner -->
    <dependency>
      <groupId>no.nav.bidrag</groupId>
      <artifactId>bidrag-backend-commons-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Generering av gyldige testdata (bl.a. fødselsnummer via genererFødselsnummer) -->
    <dependency>
      <groupId>no.nav.bidrag</groupId>
      <artifactId>bidrag-backend-generer-testdata</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot test-støtte (JUnit, Mockito, AssertJ) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test-støtte for REST-klienter (RestTemplate, WebClient), gir RestTemplateBuilder -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test-støtte for Spring MVC-controllere/REST-endepunkter, gir TestRestTemplate -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Data JPA test-støtte (in-memory database, repositories) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Embedded Kafka for integrasjonstester -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- WireMock standalone for mocking av eksterne HTTP-tjenester i tester -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock-standalone.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- WireMock for mocking av eksterne HTTP-tjenester i tester -->
    <dependency>
      <groupId>org.wiremock.integrations</groupId>
      <artifactId>wiremock-spring-boot</artifactId>
      <version>${wiremock-spring-boot.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- In-memory database for tester -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- H2 web-konsoll (eget modul i Spring Boot 4) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-h2console</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Mock OAuth2-server for lokal utvikling og tester -->
    <dependency>
      <groupId>no.nav.security</groupId>
      <artifactId>token-validation-spring-test</artifactId>
      <version>${nav-token-support.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Kotlin mocking-bibliotek -->
    <dependency>
      <groupId>io.mockk</groupId>
      <artifactId>mockk-jvm</artifactId>
      <version>${mockk.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Kotlin assertion-bibliotek -->
    <dependency>
      <groupId>io.kotest</groupId>
      <artifactId>kotest-assertions-core-jvm</artifactId>
      <version>${kotest.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Denne appen er hovedsakelig Java, med et fåtall ekte .kt-filer i en egen src/main/kotlin-
       og src/test/kotlin-mappe (samme mønster som bidrag-dokument-journalpost). Kotlin-
       kompilatoren må derfor eksplisitt få oppgitt begge kildemappene i sourceDirs, og kjøre i
       process-sources/process-test-sources før javac sin default-compile i compile/test-compile-
       fasen, slik at javac finner de allerede kompilerte Kotlin-klassene på classpath (flere
       .java-filer refererer til klasser definert i .kt-filer, bl.a. Tokeninfo, Egenskaper,
       UserCacheKey(Generator), CacheEvictBeforeWorkingHours, Arkiveringstjeneste,
       BidragDokumentkonsument), og Kotlin-kompilatoren kan lese Java-kildene for symboloppslag. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>compile</id>
            <phase>process-sources</phase>
            <configuration>
              <sourceDirs>
                <source>src/main/java</source>
                <source>src/main/kotlin</source>
              </sourceDirs>
            </configuration>
          </execution>
          <execution>
            <id>test-compile</id>
            <phase>process-test-sources</phase>
            <configuration>
              <sourceDirs>
                <source>src/test/java</source>
                <source>src/test/kotlin</source>
              </sourceDirs>
            </configuration>
          </execution>
          <!-- kotlin-maven-plugin sin lifecycle-extension (extensions=true i root-pom) legger
               automatisk til egne "default-compile"/"default-testCompile"-executions i tillegg
               til de over. Uten sourceDirs her bruker de kun standard src/main/kotlin og finner
               ikke Java-kildene i src/main/java, som feiler kompileringen. -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <sourceDirs>
                <source>src/main/java</source>
                <source>src/main/kotlin</source>
              </sourceDirs>
            </configuration>
          </execution>
          <execution>
            <id>default-test-compile</id>
            <configuration>
              <sourceDirs>
                <source>src/test/java</source>
                <source>src/test/kotlin</source>
              </sourceDirs>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <jvmTarget>${java.version}</jvmTarget>
          <compilerPlugins>
            <plugin>spring</plugin>
            <plugin>jpa</plugin>
            <plugin>lombok</plugin>
          </compilerPlugins>
          <pluginOptions>
            <option>lombok:config=${project.basedir}/lombok.config</option>
          </pluginOptions>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-maven-allopen</artifactId>
            <version>${kotlin.version}</version>
          </dependency>
          <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-maven-noarg</artifactId>
            <version>${kotlin.version}</version>
          </dependency>
          <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-maven-lombok</artifactId>
            <version>${kotlin.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <!-- javac skal kun kompilere Java-kildene fra src/main/java (Kotlin-kildene er allerede
           kompilert av kotlin-maven-plugin over og havner på classpath). default-compile/
           default-testCompile fra parent-pomen deaktiveres og erstattes med egne executions som
           peker eksplisitt på src/main/java og src/test/java, siden root-pomen sin globale
           <sourceDirectory> peker på src/main/kotlin. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-compile</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>default-testCompile</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>java-compile</id>
            <phase>compile</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <compileSourceRoots>
                <compileSourceRoot>${project.basedir}/src/main/java</compileSourceRoot>
              </compileSourceRoots>
            </configuration>
          </execution>
          <execution>
            <id>java-test-compile</id>
            <phase>test-compile</phase>
            <goals>
              <goal>testCompile</goal>
            </goals>
            <configuration>
              <compileSourceRoots>
                <compileSourceRoot>${project.basedir}/src/test/java</compileSourceRoot>
              </compileSourceRoots>
            </configuration>
          </execution>
        </executions>
        <!-- Enkelte javac-versjoner auto-oppdager ikke lenger annotasjonsprosessorer via
             classpath. Uten eksplisitt annotationProcessorPaths ville Lomboks getter/setter/
             builder-generering blitt hoppet over uten feilmelding, som gir kryptiske
             "cannot find symbol"-feil i klasser som bruker Lombok-annotasjoner. -->
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <!-- Flyway migreringsplugin. Versjon styres av spring-boot-dependencies BOM. -->
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
