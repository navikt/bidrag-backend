<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>no.nav.bidrag</groupId>
    <artifactId>bidrag-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

    <artifactId>bidrag-organisasjon</artifactId>
  <name>bidrag-organisasjon</name>
  <description>Tjeneste for å utføre handlinger / hente informasjon relatert til organisasjon</description>

  <properties>
    <nav-token-support.version>6.0.12</nav-token-support.version>
    <spring-cloud-contract-wiremock.version>5.0.3</spring-cloud-contract-wiremock.version>
    <springdoc-openapi-ui.version>3.1.0</springdoc-openapi-ui.version>
    <okhttp.version>5.4.0</okhttp.version>
    <google-guava.version>33.0.0-jre</google-guava.version>
    <wiremock-spring-boot.version>4.2.1</wiremock-spring-boot.version>
    <wiremock-standalone.version>3.13.2</wiremock-standalone.version>
    <springmockk.version>5.0.1</springmockk.version>
    <mockk.version>1.14.11</mockk.version>
    <kotest.version>6.2.3</kotest.version>
    <swagger-annotations.version>2.2.51</swagger-annotations.version>
  </properties>

  <!-- Sikrer at alle mockk-relaterte artefakter alltid samstemmer med
       mockk.version. Uten dette trekker springmockk inn en eldre
       mockk-dsl-jvm enn bidrag-backend-commons-test sin Stubs.kt er kompilert
       mot, noe som gir NoClassDefFoundError for klasser lagt til i nyere
       mockk-versjoner (f.eks. AnyTypedMatcher, introdusert i 1.14.9).
       Denne appen bruker springmockk uten en konkurrerende direkte
       avhengighet til mockk-jvm, så uten denne overstyringen vinner
       springmockk sin transitive (eldre) versjon. Verifisert med
       mvn dependency:tree -Dincludes=io.mockk. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.mockk</groupId>
        <artifactId>mockk-jvm</artifactId>
        <version>${mockk.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mockk</groupId>
        <artifactId>mockk-dsl-jvm</artifactId>
        <version>${mockk.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mockk</groupId>
        <artifactId>mockk-agent-jvm</artifactId>
        <version>${mockk.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mockk</groupId>
        <artifactId>mockk-agent-api-jvm</artifactId>
        <version>${mockk.version}</version>
      </dependency>
      <dependency>
        <groupId>io.mockk</groupId>
        <artifactId>mockk-core-jvm</artifactId>
        <version>${mockk.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>


  <dependencies>
    <!-- nav -->
    <dependency>
      <groupId>no.nav.bidrag</groupId>
      <artifactId>bidrag-backend-commons</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>no.nav.bidrag</groupId>
      <artifactId>bidrag-backend-transport</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- spring -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-ldap</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web-services</artifactId>
      <exclusions>
        <exclusion>
          <artifactId>junit</artifactId>
          <groupId>junit</groupId>
        </exclusion>
        <exclusion>
          <groupId>org.apache.tomcat.embed</groupId>
          <artifactId>tomcat-embed-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- swagger -->
