  <!-- Sikrer at alle mockk-relaterte artefakter alltid samstemmer med
       mockk.version. Uten dette trekker springmockk inn en eldre
       mockk-dsl-jvm enn bidrag-backend-commons-test sin Stubs.kt er kompilert
       mot, noe som gir NoClassDefFoundError for klasser lagt til i nyere
       mockk-versjoner (f.eks. AnyTypedMatcher, introdusert i 1.14.9).
       Denne appen bruker springmockk uten en konkurrerende direkte
       avhengighet til mockk-jvm, så uten denne overstyringen vinner
       springmockk sin transitive (eldre) versjon. Verifisert med
       mvn dependency:tree -Dincludes=io.mockk. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.mockk</groupId>
        <artifactId>mockk-jvm</artifactId>
        <version>${mockk.version}</version>
      </dependency>
