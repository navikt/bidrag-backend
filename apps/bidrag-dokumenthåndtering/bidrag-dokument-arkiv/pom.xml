    <!-- Denne appen har blandet Java/Kotlin-kildekode. Java- og Kotlin-klasser refererer til hverandre på kryss og tvers, så Kotlin-kompilator
         må kjøre i process-sources (før javac sin standard compile-fase) slik at javac finner allerede kompilerte
         Kotlin-klasser på classpath når den kompilerer .java-filene. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>process-sources</phase>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>process-test-sources</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

