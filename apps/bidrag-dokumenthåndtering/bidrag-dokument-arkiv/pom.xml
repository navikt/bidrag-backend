            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Kun brukt i src/test (se Stubs.kt/AbstractControllerTest.kt). Manglet scope=test,
             som gjorde at wiremock (og dens handlebars-avhengighet, sårbar for
             CVE-2026-55760 - path traversal via FileTemplateLoader) havnet i produksjons-jaren.
             Alle andre moduler som bruker wiremock-spring-boot har scope=test. -->
        <dependency>
            <groupId>org.wiremock.integrations</groupId>
            <artifactId>wiremock-spring-boot</artifactId>
            <version>${wiremock-spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Denne appen har blandet Java/Kotlin-kildekode. Java- og Kotlin-klasser refererer til hverandre på kryss og tvers, så Kotlin-kompilator
         må kjøre i process-sources (før javac sin standard compile-fase) slik at javac finner allerede kompilerte
         Kotlin-klasser på classpath når den kompilerer .java-filene. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>process-sources</phase>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>process-test-sources</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

