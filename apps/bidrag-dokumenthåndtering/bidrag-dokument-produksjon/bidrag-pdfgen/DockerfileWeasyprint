
FROM europe-north1-docker.pkg.dev/cgr-nav/pull-through/nav.no/python:latest AS runtime
FROM europe-north1-docker.pkg.dev/cgr-nav/pull-through/nav.no/python:latest-dev AS build
USER root

COPY --from=runtime /usr/lib/apk/ /runtime/usr/lib/apk/
COPY --from=runtime /etc/apk/ /runtime/etc/apk/
RUN ln -s usr/lib /runtime/lib \
    && mkdir -p /runtime/var/cache/apk \
    && apk --root /runtime --no-cache --no-scripts add \
        pango harfbuzz cairo qpdf fontconfig \
        font-opensans ttf-dejavu font-liberation font-noto font-noto-emoji \
        glibc-locale-nb libxcrypt

ADD --checksum=sha256:a4ebbdea20b08ccbd7bf3665a9462454eefdd01d9a6307129d3b3d4672981074 \
    https://github.com/adobe-fonts/source-sans/releases/download/3.052R/OTF-source-sans-3.052R.zip \
    /tmp/source-sans.zip
RUN mkdir -p /runtime/usr/share/fonts/opentype/source-sans \
    && unzip -j /tmp/source-sans.zip '*.otf' -d /runtime/usr/share/fonts/opentype/source-sans
COPY fonts.conf /runtime/etc/fonts/local.conf

COPY requirements.txt /tmp/requirements.txt
RUN python -m venv --without-pip /opt/venv \
    && python -m pip --python /opt/venv install --no-cache-dir --requirement /tmp/requirements.txt

FROM runtime
USER root

COPY --from=build /runtime/ /
COPY --from=build /bin/busybox /bin/sh
COPY --from=build /bin/busybox /bin/printenv
COPY --from=build /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=nb_NO.UTF-8 \
    LANGUAGE=nb_NO:nb \
    LC_ALL=nb_NO.UTF-8 \
    # Nais runs the container as uid 1001, which has no home directory. Without
    # these, fontconfig fails with "No writable cache directories" and rescans
    # every font on every single request.
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    XDG_CONFIG_HOME=/tmp/.config \
    FONTCONFIG_PATH=/etc/fonts \
    # Shared by the gunicorn workers so /metrics reports all of them, not just
    # the worker that happened to answer the scrape. See gunicorn.conf.py.
    PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus \
    PORT=8080

WORKDIR /app

COPY weasyprint_server.py metrics.py gunicorn.conf.py ./

# Warm the fontconfig cache into a world-readable location so the first request
# after a cold start is not several seconds slower than the rest.
RUN ["fc-cache", "-f"]

USER 1001

EXPOSE 8080

# Rendering is CPU-bound, so scale with processes rather than threads.
#
# The `gthread` worker class is deliberate: with the default sync worker a pod
# that is busy rendering cannot answer GET /health at all, so Kubernetes'
# readiness probe fails and the pod is pulled out of the service under exactly
# the load it is supposed to handle. WeasyPrint spends most of its time in
# Pango/cairo, which release the GIL, so a spare thread lets the trivial health
# handler be scheduled promptly without hurting render throughput.
#
# Thread count is 2, not 4. Each in-flight render holds a full document tree,
# so memory scales with threads while throughput does not. Measured with a
# 15-page saksbehandlingsnotat (2 workers, resident set of the whole container):
#
#   threads=1 -> 327 MiB, /health 0.58s under 2 concurrent renders
#   threads=2 -> 486 MiB, /health 0.007s
#   threads=4 -> 758 MiB, /health 0.007s
#
# 2 keeps a thread free to answer probes at a third less memory than 4; going
# higher only buys memory pressure. Note that under *saturation* (more requests
# than worker slots) /health queues and times out in every configuration - the
# Nais probes are tuned to tolerate that rather than restart a busy pod.
ENTRYPOINT []
SHELL ["/bin/sh", "-c"]
CMD exec gunicorn \
    --config gunicorn.conf.py \
    --worker-class gthread \
    --bind "0.0.0.0:${PORT}" \
    --workers "${GUNICORN_WORKERS:-4}" \
    --threads "${GUNICORN_THREADS:-4}" \
    --timeout "${GUNICORN_TIMEOUT:-120}" \
    --graceful-timeout 30 \
    --keep-alive 15 \
    --max-requests 200 \
    --max-requests-jitter 50 \
    --access-logfile - \
    --error-logfile - \
    weasyprint_server:app
