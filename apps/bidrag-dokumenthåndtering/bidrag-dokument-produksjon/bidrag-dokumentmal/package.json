{
  "name": "bidrag-dokumentmal",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "npm run tailwind_build && react-router build",
    "dev2": "run-p dev:*",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "icons": "npx @svgr/cli --out-dir app/components/icons -- app/icons",
    "icons:watch": "npm-watch icons",
    "dev3:svg": "run-s icons icons:watch",
    "dev": "react-router dev",
    "tailwind_dev": "tailwindcss build -i app/tailwind.css -o app/style/tw_output.css --watch",
    "dev:tailwind_dev": "tailwindcss build -i app/tailwind.css -o app/style/tw_output.css --watch",
    "tailwind_build": "tailwindcss build -i app/tailwind.css -o app/style/tw_output.css",
    "gen_api": "swagger-typescript-api generate -p http://localhost:8183/v3/api-docs --no-client -n Api.ts -o app/types"
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.20.0",
    "@navikt/ds-css": "^8.20.0",
    "@navikt/ds-react": "^8.20.0",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "undici": "^8.12.3",
    "xss": "^1.0.16"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.0",
    "@react-router/fs-routes": "^8.5.0",
    "@svgr/cli": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.48.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.13.0",
    "npm-run-all": "^4.1.5",
    "npm-watch": "^0.13.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "swagger-typescript-api": "^13.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "watch": {
    "icons": {
      "patterns": [
        "icons"
      ],
      "extensions": "svg",
      "quiet": false
    }
  }
}
