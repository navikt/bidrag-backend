  <build>
    <plugins>
      <!-- Kjør tester i flere JVM-forker parallelt for å utnytte flere CPU-kjerner på CI-runneren -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>1C</forkCount>
          <reuseForks>true</reuseForks>
        </configuration>
      </plugin>
      <!-- kapt kjører her uten at noen annotation processor faktisk er konfigurert
           (ingen <annotationProcessorPaths>), og produserer 0 genererte filer
           (bekreftet i target/generated-sources/kapt*). Det eneste den gjør er å
           auto-oppdage prosessorer på compile-classpath (deprecated oppførsel) og
           deretter varsle at de mangler i kapt-classpath. Deaktiverer de to
           arvede kapt-kjøringene for denne modulen for å spare kjøretid. -->
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>default-kapt</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>default-test-kapt</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
